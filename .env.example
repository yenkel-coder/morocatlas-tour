# Resend (https://resend.com) — envoi des emails de devis
RESEND_API_KEY=

# Adresse d'expédition — doit provenir d'un domaine vérifié sur Resend
# (ex: "Marocatlastour <contact@marocatlastour.com>").
# Si absent, retombe sur le domaine sandbox onboarding@resend.dev (risque de spam côté client).
RESEND_FROM_EMAIL=
