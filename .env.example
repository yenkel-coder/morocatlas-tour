# Resend (https://resend.com) — envoi des emails de devis
RESEND_API_KEY=

# Adresse d'expédition — doit provenir d'un domaine vérifié sur Resend
# (ex: "Marocatlastour <contact@marocatlastour.com>").
# Si absent, retombe sur le domaine sandbox onboarding@resend.dev (risque de spam côté client).
RESEND_FROM_EMAIL=

# Adresse recevant la notification de chaque nouvelle demande de devis.
# Tant que le domaine n'est pas vérifié sur Resend (mode sandbox), cette adresse
# DOIT être celle du compte Resend lui-même, sinon Resend renvoie une erreur 403.
# Si absent, retombe sur yenkel@gmail.com.
OWNER_NOTIFICATION_EMAIL=
